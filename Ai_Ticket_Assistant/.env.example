# MongoDB Connection
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/agentic_ai?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_jwt_super_secret_key_change_in_production

# Mailtrap SMTP Transactional Alert Credentials
MAILTRAP_SMTP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_SMTP_PORT=2525
MAILTRAP_SMTP_USER=your_mailtrap_user
MAILTRAP_SMTP_PASS=your_mailtrap_password

# Google Gemini API Key for Agent-Kit
GEMINI_API_KEY=your_gemini_api_key

# Web Application URLs
APP_URL=http://localhost:3000

# Inngest Dev Server Configuration
INNGEST_EVENT_KEY=local
INNGEST_DEV=1

